MAGENTO_GRAPHQL_URL=https://magento.test/graphql
MAGENTO_BASE_URL=https://magento.test
NEXT_PUBLIC_STORE=default
NEXT_PUBLIC_LOCALE=en
NEXT_PUBLIC_CURRENCY=USD
# multi-store: comma lists map 1:1 to Magento store views, or use stores=auto
NEXT_PUBLIC_STORES=default,secondstore
NEXT_PUBLIC_LOCALES=en,en
NEXT_PUBLIC_CURRENCIES=USD,USD
CHECKOUT_STRATEGY=native-magento
COMMERCE_FEATURES=os
REVALIDATE_SECRET=change-me-16-chars
HEADORA_PRESET=minimal
