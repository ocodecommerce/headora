MAGENTO_GRAPHQL_URL=https://magento.test/graphql
MAGENTO_BASE_URL=https://magento.test
NEXT_PUBLIC_STORE=default
NEXT_PUBLIC_LOCALE=en
NEXT_PUBLIC_CURRENCY=USD
# multi-store: comma lists map 1:1 to Magento store views, or use stores=auto
NEXT_PUBLIC_STORES=default,secondstore
NEXT_PUBLIC_LOCALES=en,en
NEXT_PUBLIC_CURRENCIES=USD,USD
CHECKOUT_STRATEGY=native-magento
COMMERCE_FEATURES=os
REVALIDATE_SECRET=change-me-16-chars
HEADORA_PRESET=minimal
# Brand text shown in header/footer when Magento has no logo uploaded (falls back to the store view name)
HEADORA_SITE_NAME=Headora
# Magento CMS page rendered as the homepage (empty = preset block layout)
HEADORA_HOME_PAGE=home
# Footer bottom-bar copyright (empty = Magento design/footer/copyright)
HEADORA_COPYRIGHT=Copyright © 2026 oCodecommerce.com, All rights reserved.
# Footer "Follow Us!" icons: name=url pairs (instagram, facebook, twitter, youtube)
HEADORA_SOCIAL_LINKS=instagram=https://www.instagram.com/,facebook=https://www.facebook.com/,twitter=https://x.com/
# Public storefront URL. When it is on the same host as MAGENTO_BASE_URL (production behind
# nginx), links to Magento-only pages (order history, contact, search) stay relative.
HEADORA_PUBLIC_URL=
